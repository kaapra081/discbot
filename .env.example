# Discord application token. Keep this secret.
DISCORD_TOKEN=

# Google service-account JSON, on one line. Share the Google Sheet with the
# service-account email as Viewer (or Editor if you want to use the optional
# future sheet-write features).
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Sheet1

# rotation reads the existing two-column sheet: date in column A, person in B.
# meeting reads a header row with discord_user_id and meeting_start columns.
SHEET_MODE=rotation
MEETING_TIME_LOCAL=12:45
MEETING_TIMEZONE=America/Los_Angeles
MEETING_TITLE=council

# Keys must match the person names in column B; values are Discord user IDs.
DISCORD_USER_MAP_JSON={"Adrian Poon":"123456789012345678"}

# Used when a row does not provide channel_id.
DEFAULT_DISCORD_CHANNEL_ID=

# Comma-separated minutes before each meeting. 1440 = one day, 60 = one hour,
# and 15 = fifteen minutes.
REMINDER_OFFSETS_MINUTES=1440,60,15
REMINDER_CATCH_UP_WINDOW_MINUTES=30

# How often to refresh the Sheet and how often to check for due reminders.
SHEET_SYNC_INTERVAL_MS=300000
REMINDER_TICK_INTERVAL_MS=30000

# Used only in log messages and for documentation; timestamps are read from
# the Sheet as ISO-8601 values with an explicit offset when possible.
APP_TIMEZONE=America/Los_Angeles

# Set true to log reminders without sending Discord messages.
DRY_RUN=false
